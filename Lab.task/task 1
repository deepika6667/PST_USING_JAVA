import java.util.Scanner;

public class SalaryTransformationSystem {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("===== Salary Transformation System =====");

        System.out.print("Enter Employee Name: ");
        String name = sc.nextLine();

        System.out.print("Enter Basic Salary: ");
        double basicSalary = sc.nextDouble();

        // Salary components
        double hra = basicSalary * 0.20;   // 20% HRA
        double da = basicSalary * 0.10;    // 10% DA
        double ta = basicSalary * 0.05;    // 5% TA

        double grossSalary = basicSalary + hra + da + ta;

        // Deductions
        double pf = basicSalary * 0.12;    // 12% PF
        double tax = grossSalary * 0.05;   // 5% Tax

        double totalDeduction = pf + tax;
        double netSalary = grossSalary - totalDeduction;

        // Display result
        System.out.println("\n===== Salary Details =====");
        System.out.println("Employee Name : " + name);
        System.out.printf("Basic Salary  : %.2f%n", basicSalary);
        System.out.printf("HRA           : %.2f%n", hra);
        System.out.printf("DA            : %.2f%n", da);
        System.out.printf("TA            : %.2f%n", ta);
        System.out.printf("Gross Salary  : %.2f%n", grossSalary);
        System.out.printf("PF Deduction  : %.2f%n", pf);
        System.out.printf("Tax Deduction : %.2f%n", tax);
        System.out.printf("Total Deduct. : %.2f%n", totalDeduction);
        System.out.printf("Net Salary    : %.2f%n", netSalary);

        sc.close();
    }
}
